{%- set uid = kodi_user_uid %}
#!/bin/sh
# kiosk-idle-off.sh — idle screen-off for the 3-TTY cage kiosk.
#
# When every kiosk TTY session (tty1/2/3) has been idle for more than
# {{ screen_off_after }} seconds, disable the foreground cage output with
# wlr-randr --off; re-enable it the moment any input arrives.
#
# cage v0.3.1 does not implement wlr-output-power-management-v1 (wlopm
# does not work against it), so the output itself is disabled/enabled.
# Verified safe: cage survives, and wlroots keeps the output's mode and
# scale across disable/enable, so no scale re-application is needed.
#
# Idle detection: logind's per-session IdleHint (input-based). Once all
# kiosk sessions report idle, the start of the idle period is recorded
# (wall clock) in the state file; the screen goes off once the threshold
# is exceeded. Wall clock deltas are fine here — only the delta matters.
xdg=/run/user/{{ uid }}
idle_after={{ screen_off_after }}
poll=2
state=/run/kiosk-idle-off.state   # "off", or "ts:<epoch>" while counting

# All session ids whose TTY is one of the kiosk TTYs.
kiosk_tty_ids() {
  loginctl list-sessions --no-legend | awk '$7 ~ /^tty({{ kiosk_tys | map(attribute="tty") | join("|tty") }})$/ { print $1 }'
}

# IdleHint (yes/no) for a session.
idle_hint() {
  loginctl show-session "$1" 2>/dev/null | sed -n 's/^IdleHint=//p'
}

# Every kiosk session is idle (and at least one exists).
all_idle() {
  ids=$(kiosk_tty_ids)
  [ -n "$ids" ] || return 1
  for id in $ids; do
    [ "$(idle_hint "$id")" = "yes" ] || return 1
  done
  return 0
}

# Wayland socket + bare output name of the foreground cage (the only one
# that exposes an output to wlr-randr).
find_foreground() {
  socket="" name=""
  for s in "$xdg"/wayland-*; do
    [ -S "$s" ] || continue
    first=$(WAYLAND_DISPLAY=$(basename "$s") wlr-randr 2>/dev/null | head -n 1)
    if [ -n "$first" ]; then
      socket=$(basename "$s")
      name=$(printf '%s' "$first" | cut -d ' ' -f 1)
      break
    fi
  done
}

# "on" or "off" for the foreground output.
output_state() {
  if WAYLAND_DISPLAY="$socket" wlr-randr 2>/dev/null | grep -q "Enabled: no"; then
    echo off
  else
    echo on
  fi
}

screen_off() {
  find_foreground
  if [ -n "$socket" ] && [ "$(output_state)" = "on" ]; then
    WAYLAND_DISPLAY="$socket" wlr-randr --output "$name" --off 2>/dev/null \
      && echo off > "$state"
  fi
}

screen_on() {
  find_foreground
  [ -n "$socket" ] && WAYLAND_DISPLAY="$socket" wlr-randr --output "$name" --on 2>/dev/null
  rm -f "$state"
}

while :; do
  if all_idle; then
    case "$(cat "$state" 2>/dev/null)" in
      ts:*) ;;
      *) echo "ts:$(date +%s)" > "$state" ;;
    esac
    ts=$(sed -n 's/^ts://p' "$state" 2>/dev/null)
    if [ -n "$ts" ] && [ $(( $(date +%s) - ts )) -ge "$idle_after" ]; then
      screen_off
    fi
  elif [ -s "$state" ]; then
    # Any kiosk session had input (or no kiosk sessions at all, e.g. the
    # cages are restarting): drop the counter and make sure the screen
    # is not left off.
    screen_on
  fi
  sleep "$poll"
done
