[Unit]
Description=Kiosk idle manager (inhibitor-aware screen off + logind suspend gate)
After=remote-fs.target cage-kodi.service cage-web.service cage-spotify.service user@{{ kodi_user_uid }}.service
Wants=user@{{ kodi_user_uid }}.service

[Service]
Type=simple
User={{ kodi_user }}
Group={{ kodi_user }}
Environment=HOME={{ kodi_home }}
ExecStart=/usr/local/bin/kiosk-inhibit --config {{ kiosk_inhibit_config_file }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
